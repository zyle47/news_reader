{
  "permissions": {
    "defaultMode": "dontAsk",
    "deny": [
      "Bash", "Agent", "Task", "Skill", "WebFetch", "WebSearch", "NotebookEdit",
      "Read(/.claude/**)", "Read(/.git/**)", "Read(/.env*)", "Read(/runtime/**)",
      "Edit(/.claude/**)", "Edit(/CLAUDE.md)", "Edit(/AGENTS.md)", "Edit(/tools/claude_*.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
